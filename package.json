{
  "name": "klinik-gigi-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:all": "npm run sync:docs && next dev",
    "build": "node --import tsx scripts/validate-env.ts && node --import tsx scripts/prepare-prisma.ts && next build",
    "start": "next start",
    "postinstall": "node --import tsx scripts/prepare-prisma.ts",
    "build:landing": "node --import tsx scripts/sync-landing-docs.ts",
    "export:landing": "npm run build:landing",
    "sync:docs": "npm run build:landing",
    "validate:docs": "node --import tsx scripts/sync-landing-docs.ts --validate",
    "validate:env": "node --import tsx scripts/validate-env.ts",
    "db:generate": "node --import tsx scripts/prepare-prisma.ts",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.postgresql.prisma",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:seed:dev": "node --import tsx prisma/seed.dev.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

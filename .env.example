# ============================================================
# YOVELA DENTAL CLINIC — ENVIRONMENT TEMPLATE
# Salin ke .env.local (development) atau atur di Vercel Project Settings.
# JANGAN PERNAH meng-commit .env atau .env.local ke GitHub!
# ============================================================

# 1. Runtime & Data Mode
# Development lokal boleh memakai "real" (SQLite/PostgreSQL dev) atau "mock".
# Production / Preview (Vercel) WAJIB "real" (aplikasi menolak "mock").
NODE_ENV=development
APP_DATA_MODE=real

# 2. Database Connection
# Development Lokal (SQLite):
DATABASE_URL="file:./dev.db"
# Production / Preview (Neon atau Supabase PostgreSQL — gunakan Pooled URL):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/yovela_prod?sslmode=require"
# DIRECT_URL (khusus migrasi Prisma di Neon/Supabase):
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/yovela_prod?sslmode=require"

# 3. Authentication Secret (WAJIB diisi min. 32 karakter acak di Production)
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# Alias kompatibilitas (opsional jika masih memakai SESSION_SECRET):
# SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# 4. Public Base URL (non-rahasia)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. Email Transaksional (Opsional — untuk reset kata sandi di Production via Resend)
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
# MAIL_FROM="Yovela Dental Clinic <no-reply@yoveladental.id>"
